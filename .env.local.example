# 문의 폼 전송 설정 (src/lib/inquiry.ts)
#
# 1. https://web3forms.com 에서 수신할 이메일 주소를 입력하면 access key가 메일로 온다.
# 2. 아래 값을 채워 .env.local 로 복사한다.
# 3. Vercel에 배포할 때는 프로젝트 Settings > Environment Variables 에도 같은 값을 넣는다.
#
# access key는 브라우저에 노출되지만, 등록된 수신 이메일로만 전달되므로 안전하다.

NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ACCESS_KEY=
